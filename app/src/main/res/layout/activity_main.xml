<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ASync" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:id="@+id/permission_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <Button android:id="@+id/grant_storage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Grant all-files access" />
        <EditText android:id="@+id/server_url" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="https://vault.example.com" android:inputType="textUri" />
        <Button android:id="@+id/open_server_login" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open server login" />
        <EditText android:id="@+id/pairing_token" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Paste pairing token" android:inputType="text" />
        <Button android:id="@+id/sign_in" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pair device" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/export_settings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Export settings" />
            <Button android:id="@+id/import_settings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Import settings" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open the server login in your browser, choose Pair a new Android device, then paste the one-time token here." android:textSize="12sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Sync folders" android:textStyle="bold" />
        <CheckBox android:id="@+id/folder_dcim" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DCIM" />
        <CheckBox android:id="@+id/delete_dcim" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:text="Auto-delete DCIM after 7 verified days" android:textSize="12sp" />
        <CheckBox android:id="@+id/folder_download" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Download" />
        <CheckBox android:id="@+id/delete_download" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:text="Auto-delete Download after 7 verified days" android:textSize="12sp" />
        <CheckBox android:id="@+id/folder_pictures" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pictures" />
        <CheckBox android:id="@+id/delete_pictures" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:text="Auto-delete Pictures after 7 verified days" android:textSize="12sp" />
        <CheckBox android:id="@+id/folder_movies" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Movies" />
        <CheckBox android:id="@+id/delete_movies" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:text="Auto-delete Movies after 7 verified days" android:textSize="12sp" />
        <Button android:id="@+id/save_folders" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Save folders" />
        <Button android:id="@+id/sync_now" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sync now and schedule Wi-Fi sync" />
        <CheckBox android:id="@+id/watch_enabled" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Watch folders for new files" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Uses a foreground notification and keeps the periodic scan as a safety net." android:textSize="12sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Debug log" android:textStyle="bold" />
        <TextView android:id="@+id/debug_log" android:layout_width="match_parent" android:layout_height="160dp" android:layout_marginTop="8dp" android:background="?android:attr/colorBackground" android:gravity="top" android:padding="8dp" android:scrollbars="vertical" android:textColor="?android:attr/textColorPrimary" android:textSize="11sp" android:textIsSelectable="true" />
        <Button android:id="@+id/clear_debug_log" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clear debug log" />
        <TextView android:id="@+id/build_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="?android:attr/textColorSecondary" android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
